{
  "name": "wildeye",
  "private": true,
  "version": "0.1.1",
  "description": "A biodiversity globe: species occurrences, animal tracks, birds and environmental layers on a 3D Earth. Runs in a browser.",
  "type": "module",
  "license": "MIT",
  "author": "Bilawal Sidhu",
  "homepage": "https://github.com/musharna/wildeye#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/musharna/wildeye.git"
  },
  "bugs": {
    "url": "https://github.com/musharna/wildeye/issues"
  },
  "engines": {
    "node": ">=24.14.0 <25 || >=26 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "biodiversity",
    "wildlife",
    "gbif",
    "animal-tracking",
    "bird-migration",
    "geospatial",
    "visualization"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "perf:callcount": "node scripts/callcount-check.mjs",
    "perf:load": "node scripts/load-budget-check.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs",
    "qa:observed-time": "node scripts/qa-observed-time.mjs",
    "seed": "bash pipeline/seed.sh",
    "build:geoid-grid": "node scripts/build-geoid-grid.mjs"
  },
  "dependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "egm96-universal": "^1.1.1",
    "pbf": "^5.1.2",
    "puppeteer": "^25.12.0",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "protobufjs": "^8.6.6",
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.23",
    "ip-address": "^10.3.1"
  }
}
